@article{SWE_Bader_Kemm,
	title = {The Carbuncle Phenomenon in Shallow Water Simulations},
	abstract = {The carbuncle phenomenon, an instability of discrete shock proﬁles, has been known in gas dynamics simulations for a long time. Only recently, it was also observed in shallow water simulations. It was shown that the mechanisms and cures in shallow water are closely related to the mechanisms and cures in gas dynamics. In this paper, we give further evidence of that and, by means of new test cases, give evidence of the strength of our {HLLEMCC} approach to avoid the carbuncle in shallow water.},
	author = {Bader, Georg and Kemm, Friedemann},
	date = {2014},
	langid = {english},
	file = {PDF:/home/user/Zotero/storage/6P39AMHS/Bader and Kemm - 2014 - The Carbuncle Phenomenon in Shallow Water Simulations.pdf:application/pdf},
}

